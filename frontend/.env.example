# URL del backend FastAPI.
# IMPORTANTE: usar "localhost" (igual que el frontend, http://localhost:5173), NO "127.0.0.1".
# Para el navegador, localhost y 127.0.0.1 son SITIOS DISTINTOS: con 127.0.0.1 la cookie
# HttpOnly (SameSite=Lax) no viajaría en los pedidos y el login "no quedaría guardado".
VITE_API_URL=http://localhost:8000
