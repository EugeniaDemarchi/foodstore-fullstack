# Copiar este archivo como .env y completar los valores.
# El .env NO se entrega ni se sube al repositorio (está en .gitignore).

# Conexión a la base de datos — PostgreSQL
# Formato: postgresql+psycopg://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg://postgres:COMPLETAR_CLAVE@127.0.0.1:5432/food_store?connect_timeout=5

# Origen permitido por CORS (frontend Vite)
FRONTEND_ORIGIN=http://localhost:5173

# JWT: clave de al menos 32 caracteres aleatorios.
# Para generarla:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=COMPLETAR
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
